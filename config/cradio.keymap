#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp ENTER>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&caps_word>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp Q  &kp W  &kp F  &kp P  &kp B        &kp J  &kp L  &kp U      &kp Y    &kp SEMI
    &kp A  &kp R  &kp S  &kp T  &kp G        &kp M  &kp N  &kp E      &kp I    &kp O
    &kp Z  &kp X  &kp C  &kp D  &kp V        &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH
                        &kp SPACE  &mo 1   &mo 2  &kp BSPC
            >;
        };

        nav_layer {
            bindings = <
    &none     &none     &none      &none      &none         &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp DEL
    &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &none         &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER
    &none     &none     &none      &none      &none         &none      &none     &none     &none      &none
                                   &trans     &trans        &trans     &trans
            >;
        };

        num_layer {
            bindings = <
    &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT         &none  &none      &none      &none     &none
    &kp SQT    &kp N4  &kp N5  &kp N6  &kp EQUAL        &none  &sk RSHFT  &sk RCTRL  &sk RALT  &sk RGUI
    &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp MINUS        &none  &none      &none      &none     &none
                               &kp N0  &trans           &trans &trans
            >;
        };

        adjust_layer {
            bindings = <
    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none         &none  &none  &none  &none  &bootloader
    &none       &none         &none         &none         &none         &none  &none  &none  &none  &none
    &none       &none         &none         &none         &none         &none  &none  &none  &none  &sys_reset
                                            &trans        &trans        &trans &trans
            >;
        };
    };
};
