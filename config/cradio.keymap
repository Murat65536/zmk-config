#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define NAV_NUM 1
#define SYM     2
#define SYS     3

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc_left {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_esc_right {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp TAB>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp DEL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp Q       &kp W      &kp F       &kp P       &kp B        &kp J        &kp L       &kp U       &kp Y      &kp SEMI
    &hm LGUI A  &hm LALT R &hm LSHFT S &hm LCTRL T &kp G        &kp M        &hm RCTRL N &hm RSHFT E &hm RALT I &hm RGUI O
    &kp Z       &kp X      &kp C       &kp D       &kp V        &kp K        &kp H       &kp COMMA   &kp DOT    &kp FSLH
                                       &lt NAV_NUM TAB &kp SPACE &kp BSPC &lt SYM ENTER
            >;
        };

        nav_num_layer {
            bindings = <
    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5       &kp N6     &kp N7     &kp N8     &kp N9     &kp N0
    &kp LGUI   &kp LALT   &kp LSHFT  &kp LCTRL  &none        &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp CAPSLOCK
    &none      &none      &none      &none      &sl SYS      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp INS
                                     &trans     &trans       &trans     &trans
            >;
        };

        sym_layer {
            bindings = <
    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR
    &kp GRAVE  &kp TILDE  &kp BSLH   &kp PIPE   &none        &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp SQT
    &none      &none      &none      &none      &sl SYS      &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp DQT
                                     &trans     &trans       &trans     &trans
            >;
        };

        sys_layer {
            bindings = <
    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5         &kp F6       &kp F7       &kp F8       &kp F9       &kp F10
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &kp C_PP     &kp F11
    &bt BT_CLR   &bt BT_NXT   &bt BT_PRV   &none        &none          &none        &none        &none        &none        &kp F12
                                           &trans       &trans         &trans       &trans
            >;
        };
    };
};
